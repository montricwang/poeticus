{
  "id": "zhou-bangyan-liu-chou-zheng-dan-yi-shi-jiu",
  "language": "zh-Hans",
  "dynasty": "宋",
  "author": "周邦彦",
  "tune": "六丑",
  "subtitle": null,
  "title": "六丑·正单衣试酒",
  "incipit": "正单衣试酒",
  "preface": null,
  "stanzas": [
    [
      "正单衣试酒，恨客里、光阴虚掷。",
      "愿春暂留，春归如过翼。",
      "一去无迹。",
      "为问花何在，夜来风雨，葬楚宫倾国。",
      "钗钿堕处遗香泽。",
      "乱点桃蹊，轻翻柳陌。",
      "多情为谁追惜。",
      "但蜂媒蝶使，时叩窗隔。"
    ],
    [
      "东园岑寂。",
      "渐蒙笼暗碧。",
      "静绕珍丛底，成叹息。",
      "长条故惹行客。",
      "似牵衣待话，别情无极。",
      "残英小、强簪巾帻。",
      "终不似一朵，钗头颤袅，向人侧。",
      "漂流处、莫趁潮汐。",
      "恐断红、尚有相思字，何由见得。"
    ]
  ],
