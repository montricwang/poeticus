{
  "id": "xin-qiji-mo-yu-er-geng-neng-xiao",
  "language": "zh-Hans",
  "dynasty": "宋",
  "author": "辛弃疾",
  "tune": "摸鱼儿",
  "subtitle": null,
  "title": "摸鱼儿·更能消几番风雨",
  "incipit": "更能消几番风雨",
  "preface": "淳熙己亥，自湖北漕移湖南，同官王正之置酒小山亭，为赋。",
  "stanzas": [
    [
      "更能消几番风雨，匆匆春又归去。",
      "惜春长怕花开早，何况落红无数。",
      "春且住！见说道天涯芳草无归路。",
      "怨春不语，算只有殷勤，画檐蛛网尽日惹飞絮。"
    ],
    [
      "长门事，准拟佳期又误，蛾眉曾有人妒。",
      "千金纵买相如赋，脉脉此情谁诉？",
      "君莫舞！君不见，玉环飞燕皆尘土。",
      "闲愁最苦，休去倚危栏，斜阳正在烟柳断肠处。"
    ]
  ],
