{
  "id": "ouyang-xiu-lang-tao-sha-ba-jiu-zhu-dong-feng",
  "language": "zh-Hans",
  "dynasty": "宋",
  "author": "欧阳修",
  "tune": "浪淘沙",
  "subtitle": null,
  "title": "浪淘沙·把酒祝东风",
  "incipit": "把酒祝东风",
  "preface": null,
  "stanzas": [
    [
      "把酒祝东风。",
      "且共从容。",
      "垂杨紫陌洛城东。",
      "总是当时携手处，游遍芳丛。"
    ],
    [
      "聚散苦匆匆。",
      "此恨无穷。",
      "今年花胜去年红。",
      "可惜明年花更好，知与谁同。"
    ]
  ],
