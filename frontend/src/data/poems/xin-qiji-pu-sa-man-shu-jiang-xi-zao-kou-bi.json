{
  "id": "xin-qiji-pu-sa-man-shu-jiang-xi-zao-kou-bi",
  "language": "zh-Hans",
  "dynasty": "宋",
  "author": "辛弃疾",
  "tune": "菩萨蛮",
  "subtitle": "书江西造口壁",
  "title": "菩萨蛮·书江西造口壁",
  "incipit": "郁孤台下清江水",
  "preface": null,
  "stanzas": [
    [
      "郁孤台下清江水。",
      "中间多少行人泪。",
      "西北是长安。",
      "可怜无数山。"
    ],
    [
      "青山遮不住。",
      "毕竟江流去。",
      "江晚正愁予。",
      "山深闻鹧鸪。"
    ]
  ],
  "sources": [
    {
      "kind": "import_base",
